# Copy this file to .env.local:
#   cp .env.example .env.local

# Public image CDN only (no API key in the browser)
VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# Leave empty in local dev — Vite proxies Laravel routes (same-origin, no CORS).
VITE_BACKEND_URL=

# Where Vite proxies /api, /sanctum, /login, etc.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
