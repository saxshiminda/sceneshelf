# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Free TMDB API key: https://www.themoviedb.org/settings/api

VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# Optional — IMDb ratings via OMDb: https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=

# Leave empty in local dev — Vite proxies Laravel routes (same-origin, no CORS).
# Set to full URL only for non-proxied setups, e.g. http://localhost:8000
VITE_BACKEND_URL=

# Where Vite proxies /api, /sanctum, /login, etc. (php artisan serve)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
